# NBA Players Scraper - Enhanced Configuration
# Copy this file to .env and modify the values as needed

# Server Configuration
PORT=3001
NODE_ENV=development

# NBA API Configuration
NBA_API_BASE_URL=https://www.nba.com/stats/players/list
NBA_PLAYERS_ENDPOINT=https://stats.nba.com/stats/playerindex
REQUEST_DELAY=1000

# HTTP Client Configuration
HTTP_TIMEOUT=30000
MAX_SOCKETS=10
MAX_FREE_SOCKETS=5
KEEP_ALIVE=true
KEEP_ALIVE_MSECS=30000

# Scraping Queue Configuration
SCRAPING_CONCURRENCY=3
BATCH_SIZE=50
CHECKPOINT_INTERVAL=100
MAX_RETRIES=3
RETRY_DELAY=1000

# File Paths
DATA_FILE_PATH=./src/data/players.json
BACKUP_PATH=./src/data/backups
CHECKPOINT_PATH=./src/data/.scraping-checkpoint.json
MAX_BACKUPS=10

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_SUCCESS=true
RATE_LIMIT_SKIP_FAILED=true

# Monitoring Configuration
ENABLE_STATS=true
STATS_INTERVAL=30000
ENABLE_DISK_SPACE=true
ENABLE_MEMORY=true

# Production Settings
GRACEFUL_SHUTDOWN_TIMEOUT=30000
ENABLE_COMPRESSION=true
LOG_LEVEL=info
ENABLE_METRICS=true

# Database Configuration (if using database instead of JSON)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nba_players
# DB_USER=postgres
# DB_PASSWORD=password
# DB_SSL=false

# Redis Configuration (for caching and queue management)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# External Services
# SENTRY_DSN=your_sentry_dsn_here
# SLACK_WEBHOOK_URL=your_slack_webhook_here